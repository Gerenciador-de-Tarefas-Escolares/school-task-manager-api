# Os valores abaixo devem corresponder aos configurados no .env do banco (DB_NOME, DB_USUARIO, DB_SENHA)
DB_URL=jdbc:postgresql://localhost:5432/gerenciador_tarefas
DB_USER=gerenciador
DB_PASSWORD=troque_esta_senha

# Chave secreta em Base64 (mínimo 256 bits) para assinatura dos tokens JWT
JWT_SECRET=substitua_por_uma_chave_secreta_base64_de_256_bits
JWT_EXPIRATION=86400000

# Credenciais Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=seu_client_://googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
